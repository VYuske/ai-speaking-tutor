# Copie para .env e ajuste se necessário.
# O Docker Compose lê este arquivo automaticamente.

# Perfil de modelos: skeleton | compact | balanced
AST_PROFILE=skeleton

# Endpoint do LLM. O compose inclui o serviço `ollama-proxy` (socat), que expõe
# o Ollama do host (127.0.0.1:11434) em 172.17.0.1:11435 só para a bridge Docker,
# sem precisar de OLLAMA_HOST nem sudo. O host continua usando 127.0.0.1:11434.
AST_OLLAMA_BASE_URL=http://host.docker.internal:11435/v1
AST_LLM_MODEL=qwen3.5:4b

# Nível de log da API
AST_LOG_LEVEL=INFO
